digraph review_six_phase {
  graph [charset="UTF-8", rankdir=TB, bgcolor="white", fontname="Microsoft YaHei", fontsize=12,
         newrank=true, nodesep=0.28, ranksep=0.30, pad=0.25, dpi=150];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=10.5,
         color="#4A5568", fillcolor="#F7FAFC", penwidth=1.2, margin="0.14,0.06"];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4A5568", arrowsize=0.7];

  entry [label="runReviewPass 入口\nmessages = [system prompt, 初始 user 消息]\n初始 user = caseId + issue + diff", fillcolor="#2B6CB0", fontcolor="white", penwidth=0];
  round [label="Round 开始\nround = 1，phaseIndex = 0（0-based，对应 Phase 1）\nmaxRounds = limits.loop.maxRounds（缺省 3）", fillcolor="#FEFCBF"];

  p1 [label="Phase 1 / 6 — Change Understanding（变更理解）\n回复 {\"summary\": \"一段英文变更摘要\"}"];
  p2 [label="Phase 2 / 6 — Risk Classification（风险分类）\n回复 {\"riskClass\": \"Low\"|\"Medium\"|\"High\", \"reason\"}"];
  p3 [label="Phase 3 / 6 — Context Decision（上下文决策）\n回复 {\"neededContext\": [...], \"reason\"}"];
  p4 [label="Phase 4 / 6 — Context Retrieval（上下文检索）\n可调用七工具；回复 {\"notes\"}"];
  p5 [label="Phase 5 / 6 — Deep Reasoning（深度推理）\n回复 {\"candidates\": [Finding...]}\nNo Evidence, No Finding"];
  p6 [label="Phase 6 / 6 — Evidence Verification（证据核验）\n回复 {\"verdicts\": [{id, pass, reason}], \"complete\": bool}\n每个候选一条裁决；complete=false 表示还要再审"];

  tools [label="相位内工具子循环（任一相位都可触发）\n模型回复 toolCall → 串行执行 → 结果回填后再请求\n单 run 硬上界 MAX_TOOL_CALLS = 100\n超限：Error: tool call budget exhausted\nphaseLog.note = N tool call(s) skipped", fillcolor="#E6FFFA"];
  parse [label="文本回复收尾当前相位\nparsePhaseReply 宽松 JSON 提取\n整串 → 剥围栏 → 花括号配平\n解析失败：phaseLog.parseFailure\n本轮空结果继续，不重试", fillcolor="#FEFCBF"];
  phaseLog [label="phaseLog 记录\nround / phase / requestCount / note / parseFailure", fillcolor="#C6F6D5"];

  norm [label="候选确定性归一化 normalizeCandidates\nid / severity 别名 / confidence 百分数\nline 取首行 / evidence 单值包数组\nfile 反斜杠 / category / rule / title 去空白\n只修信封，不造证据", fillcolor="#FEFCBF"];

  subgraph cluster_skill {
    label="Phase 5 文本收尾之后、Phase 6 指令之前：规则 Skill 会话（ADR-0014）";
    fontname="Microsoft YaHei"; fontsize=10.5; color="#D6BCFA"; style="rounded,dashed";
    skill_start [label="对每个未降级的规则包\n独立 Agent，种子 = Phase 5 末消息快照\n各自 fork Ledger（互不可见）", fillcolor="#FAF5FF"];
    skill_run   [label="skill 会话\n七检视工具 + bash（跑包内脚本）\n单请求 reviewTurnMs 180s\n整会话 skillPassMs 1200s\nbash 单次 skillBashMs 120s", fillcolor="#FAF5FF"];
    skill_time  [label="超时 / 失败\nstatus = failed，degradedReason\n不拖垮主检视", fillcolor="#FED7D7"];
    skill_norm  [label="候选归一化\nid 模板 RULE-CHECK@<skill>@<file>:<line>\n缺 id → round-N-skill-K-candidate-I", fillcolor="#FAF5FF"];
    skill_merge [label="与主候选跨 skill 去重\nkey = (file, line, category)\n主候选占键、永不被丢弃\n存活候选并入本轮候选流", fillcolor="#FAF5FF"];
    skill_start -> skill_run -> skill_norm -> skill_merge;
    skill_run -> skill_time [label=" 失败 "];
    skill_time -> skill_merge [style=dashed, label=" 空候选 "];
  }

  repair [label="有界候选修复（P1）\n只挑 schema 仍非法的候选\n整 run 最多 2 次调用 / 每次最多 8 条\n复用 oneShotMs + oneShot 重试\n强制保留原 id（Phase 6 对齐键）", fillcolor="#FEFCBF"];

  subgraph cluster_gate {
    label="候选拦截链 applyCandidateGate（每候选只留首个失败阶段）";
    fontname="Microsoft YaHei"; fontsize=10.5; color="#F6AD55"; style="rounded,dashed";
    g1 [label="1. SCHEMA_INVALID\n十字段校验失败", fillcolor="#FFF5F5"];
    g2 [label="2. NON_ENGLISH\ntitle / description / evidence 含 CJK", fillcolor="#FFF5F5"];
    g3 [label="3. NO_EVIDENCE\nevidence 为空数组或全空串", fillcolor="#FFF5F5"];
    g4 [label="4. VERIFICATION_FAILED\n无裁决 / pass=false", fillcolor="#FFF5F5"];
    g5 [label="5. OUT_OF_SCOPE\nfindingScope 开启：文件不在 diff\n或行号出 hunk ±10 行", fillcolor="#FFF5F5"];
    g6 [label="6. DUPLICATE_ID\n跨轮内容键 (file,line,title) 已发过", fillcolor="#FFF5F5"];
    g1 -> g2 -> g3 -> g4 -> g5 -> g6;
  }

  finding [label="Finding 产出\nid / severity / category / file / line\ntitle / description / evidence / rule / confidence", fillcolor="#C6F6D5"];
  decision[label="本轮结束判定", shape=diamond, fillcolor="#FEFCBF"];
  finish [label="结束\ncomplete = complete && !truncated\nfindings 返回给 runReviewPass\n落盘 transcript / reviews_en.json / audit", fillcolor="#2B6CB0", fontcolor="white", penwidth=0];
  next   [label="round += 1\nphaseIndex = 0\n清空本轮候选与裁决\n（最后一轮强制 complete，不置 truncated）", fillcolor="#FEFCBF"];
  trunc  [label="finish_reason = length\n→ truncated = true\n原因 MODEL_MAX_TOKENS_REACHED", fillcolor="#FED7D7"];

  entry -> round -> p1 -> p2 -> p3 -> p4 -> p5 -> p6;
  p4 -> tools [style=dashed, label=" 例：Phase 4 取上下文 "];
  p1 -> tools [style=dotted];
  p2 -> tools [style=dotted];
  p3 -> tools [style=dotted];
  p5 -> tools [style=dotted];
  p6 -> tools [style=dotted];
  tools -> parse [style=dashed, label=" 文本轮 "];
  parse -> phaseLog [style=dotted, label=" 每相位一条 "];
  p5 -> norm [label=" 候选回复 "];
  norm -> skill_start;
  skill_merge -> p6 [label=" 两批候选一起交给 Phase 6 "];
  p6 -> repair -> g1;
  g6 -> finding [label=" 全部通过 "];
  g1 -> decision [style=dashed, label=" 任一失败 → rejection（不影响其他候选） "];
  finding -> decision;
  decision -> finish [label=" complete 或 round >= maxRounds "];
  decision -> next [label=" 未完成且还有轮次 "];
  next -> p1 [style=dashed, label=" 下一轮 Phase 1 "];
  trunc -> decision [style=dashed, label=" 截断不宣称完整 "];

  { rank=same; p4; tools; }
  { rank=same; p5; norm; skill_start; }
  { rank=same; p6; repair; g1; }
  { rank=same; decision; }
}
