// 图 6：全仓 token 策略（docs/design/全仓扫描-方案与契约.md §4.6）
// 渲染：dot -Tpng -Gdpi=150 06-repo-token-strategy.dot -o 06-repo-token-strategy.png
digraph RepoTokenStrategy {
  graph [
    rankdir=TB,
    fontname="Microsoft YaHei",
    fontsize=13,
    nodesep=0.38,
    ranksep=0.34,
    pad=0.25,
    bgcolor="white"
  ];
  node [
    fontname="Microsoft YaHei",
    fontsize=10.5,
    shape=box,
    style="rounded,filled",
    fillcolor="#F7F9FC",
    color="#5B7DB1",
    penwidth=1.1,
    margin="0.16,0.09"
  ];
  edge [
    fontname="Microsoft YaHei",
    fontsize=9.5,
    color="#5B7DB1",
    arrowsize=0.75
  ];

  group [label="分组预算\n5 文件 / 80k 估算字符\n大文件 solo 至 120k", fillcolor="#E8F0FE", penwidth=1.5];
  snapshot [label="整组中性文件快照\n一次注入初始 user 消息\n不重复 get_file", fillcolor="#EEF4FF"];
  rounds [label="maxRounds=1（repo 缺省）\n一组一次六阶段\n不重复整轮上下文", fillcolor="#EEF4FF"];
  tools [label="工具预算 8 次/文件\n5 文件组上限 40\nretrieval: 1 次/文件\n连续空搜索 2 次\n单 run 120k 字符", fillcolor="#FFF8E8", color="#D98E2B"];
  cache [label="固定 system prompt / 阶段指令 / 工具 schema\n跨组共享前缀 → prompt cache", fillcolor="#EAF7EE", color="#3C8D5A"];
  skills [label="规则 Skill 复用 Phase 5 快照\n每个 Skill 只跑一个独立会话\n不重跑 Phase 1–5", fillcolor="#FFF8E8", color="#D98E2B"];
  guards [label="默认关闭不必要请求\ncoverage.repair / phase5Sweep\ntestFiles 缺省跳过", fillcolor="#F3EEFF", color="#7B61B5"];
  budget [label="maxTotalTokens 全局闸\n达到后停止派发新组\n未跑组记 not-reached", fillcolor="#FDECEC", color="#C0504D"];
  result [label="单组 token 有界\n全仓总量有上限", fillcolor="#EAF7EE", color="#3C8D5A", penwidth=1.5];

  group -> snapshot -> rounds -> tools -> cache -> skills -> guards -> budget -> result;
  snapshot -> tools [label="快照已含整文件\n检索只补跨文件契约", style=dashed, color="#D98E2B", fontcolor="#D98E2B"];
  cache -> result [label="缓存命中降低未命中输入", style=dashed, color="#3C8D5A", fontcolor="#3C8D5A"];
  budget -> result [label="达到上限即停派", style=dashed, color="#C0504D", fontcolor="#C0504D"];

  note [shape=note, label="R-06 对照（repo-spike 6 文件/60k，MR 语义）：\n总 token 68.63M vs OCR 95.51M；未命中输入 5.63M vs 10.29M；\n缓存命中 57.46M。数字是历史量级，不是当前基线。", fillcolor="#FFF8E8", color="#D98E2B", fontsize=9];
  cache -> note [style=dotted, arrowhead=none, color="#999999"];
}
