// 图 5：组内六阶段与规则 Skill（docs/design/全仓扫描-方案与契约.md §4.5）
// 渲染：dot -Tpng -Gdpi=150 05-six-phases-skills.dot -o 05-six-phases-skills.png
digraph SixPhasesSkills {
  graph [
    rankdir=TB,
    fontname="Microsoft YaHei",
    fontsize=13,
    nodesep=0.38,
    ranksep=0.34,
    pad=0.25,
    bgcolor="white"
  ];
  node [
    fontname="Microsoft YaHei",
    fontsize=10.5,
    shape=box,
    style="rounded,filled",
    fillcolor="#F7F9FC",
    color="#5B7DB1",
    penwidth=1.1,
    margin="0.16,0.09"
  ];
  edge [
    fontname="Microsoft YaHei",
    fontsize=9.5,
    color="#5B7DB1",
    arrowsize=0.75
  ];

  start [label="一个 RepoGroup\n≤5 文件 / ≤80k 估算字符\n（大文件可 solo 至 120k）", fillcolor="#E8F0FE", penwidth=1.5];
  p1 [label="Phase 1 · Code Understanding\n本组文件 / 符号 / 执行路径摘要"];
  p2 [label="Phase 2 · Risk Classification\nLow / Medium / High"];
  p3 [label="Phase 3 · Context Decision\nneededContext（可为空）"];
  p4 [label="Phase 4 · Context Retrieval\n工具检索（受工具预算与 retrieval 限）"];
  p5 [label="Phase 5 · Deep Reasoning\n产出候选 findings\nlanguageRules.repo 时注入语言清单", fillcolor="#EEF4FF"];
  seed [label="Phase 5 末消息快照\nsystem prompt + Phase 1–5 历史", shape=note, fillcolor="#FFF8E8", color="#D98E2B", fontsize=9];
  hasSkills [label="配置了规则 Skill？", shape=diamond, fillcolor="#FFF4E5", color="#D98E2B", margin="0.08,0.05"];
  skills [label="每个 Skill 一个独立 Agent\n种子 = 同一快照\n只跑 skill 指令，不重跑 Phase 1–5\n候选按文件/行/类别去重", fillcolor="#FFF8E8", color="#D98E2B"];
  merge [label="候选合并\n主候选 + Skill 候选"];
  p6 [label="Phase 6 · Evidence Verification\n逐条 verdicts: pass true / false\ncomplete true / false", fillcolor="#EEF4FF"];
  gate [label="候选门（代码）\nschema / evidence / scope / 去重"];
  ok [label="findings\ncoverage / 上报", fillcolor="#EAF7EE", color="#3C8D5A", penwidth=1.5];
  next [label="complete=false\n且未到 maxRounds？", shape=diamond, fillcolor="#FFF4E5", color="#D98E2B", margin="0.08,0.05"];
  more [label="下一轮\n回到 Phase 1", fillcolor="#FDECEC", color="#C0504D"];
  done [label="结束本轮\nmaxRounds / complete=true", fillcolor="#EAF7EE", color="#3C8D5A"];

  start -> p1 -> p2 -> p3 -> p4 -> p5;
  p5 -> seed;
  seed -> hasSkills;
  hasSkills -> skills [label=" 是"];
  hasSkills -> merge [label=" 否\n主候选", style=dashed];
  p5 -> merge [label="主候选"];
  skills -> merge [label="Skill 候选"];
  merge -> p6;
  p6 -> gate;
  gate -> ok [label="通过"];
  gate -> next [label="结束本轮"];
  p6 -> next [label="complete=false", style=dashed, color="#D98E2B", fontcolor="#D98E2B"];
  next -> more [label=" 是"];
  next -> done [label=" 否 / 已达上限"];
  more -> p1 [style=dashed, color="#C0504D", fontcolor="#C0504D"];

  note [shape=note, label="Phase 6 的 pass 是模型裁决；schema / evidence / scope / 去重由代码候选门执行。\nSkill 会话不重跑六阶段，复用 Phase 5 快照与 system prompt。", fillcolor="#FFF8E8", color="#D98E2B", fontsize=9];
  p6 -> note [style=dotted, arrowhead=none, color="#999999"];
}
