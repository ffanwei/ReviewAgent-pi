// 图 2：文件枚举与过滤（docs/design/全仓扫描-方案与契约.md §3.3）
// 渲染：dot -Tpng -Gdpi=150 02-enumerate.dot -o repo-review-enumerate-flow.png
digraph EnumerateFlow {
  graph [
    rankdir=TB,
    fontname="Microsoft YaHei",
    fontsize=13,
    nodesep=0.46,
    ranksep=0.40,
    pad=0.25,
    bgcolor="white"
  ];
  node [
    fontname="Microsoft YaHei",
    fontsize=10.5,
    shape=box,
    style="rounded,filled",
    fillcolor="#F7F9FC",
    color="#5B7DB1",
    penwidth=1.1,
    margin="0.18,0.10"
  ];
  edge [
    fontname="Microsoft YaHei",
    fontsize=9.5,
    color="#5B7DB1",
    arrowsize=0.75
  ];

  git [label="发现文件\ngit ls-files\n+ git ls-files --others --exclude-standard", fillcolor="#E8F0FE"];
  merge [label="合并 → 去重 → 字典序排序"];
  path [label="路径筛选\n--path / --files 前缀或精确路径\n→ --include 白名单 / --exclude 黑名单（exclude 优先）\n→ 排除目录 / 文件名 / 后缀（内置规则）\n不命中 → excluded-path"];
  content [label="内容与类型筛选\n二进制嗅探（前 8 KB 含 NUL）\n源码扩展名白名单\n不通过 → binary / unsupported-extension"];
  size [label="尺寸与读取\n单文件 maxFileChars\n读取失败 / 空文件\n→ too-large / read-failed / empty"];
  cap [label="全局文件数上限\nmaxFiles（按排序截断）\n剩余 → over-max-files"];
  selected [label="selected：进入分组", fillcolor="#EAF7EE", color="#3C8D5A", penwidth=1.5];
  skipped [label="skippedFiles\n每个被跳过文件一条\n{ path, reason }", fillcolor="#FDECEC", color="#C0504D"];

  git -> merge -> path -> content -> size -> cap -> selected;
  path -> skipped [style=dashed, color="#C0504D", constraint=false];
  content -> skipped [style=dashed, color="#C0504D", constraint=false];
  size -> skipped [style=dashed, color="#C0504D", constraint=false];
  cap -> skipped [style=dashed, color="#C0504D", constraint=false];

  note [shape=note, label="任一阶段未通过 → skippedFiles（每条 {path, reason}）\nreason 取值\nbinary / unsupported-extension / too-large /\nread-failed / empty / excluded-path /\nover-max-files / unknown", fillcolor="#FFF8E8", color="#D98E2B", fontsize=9];
  skipped -> note [style=dotted, arrowhead=none, color="#999999"];
}
