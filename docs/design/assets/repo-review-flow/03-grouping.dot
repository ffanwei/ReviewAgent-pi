// 图 3：分组与预算（docs/design/全仓扫描-方案与契约.md §4）
// 渲染：dot -Tpng -Gdpi=150 03-grouping.dot -o repo-review-grouping-flow.png
digraph GroupingFlow {
  graph [
    rankdir=TB,
    fontname="Microsoft YaHei",
    fontsize=13,
    nodesep=0.42,
    ranksep=0.38,
    pad=0.25,
    bgcolor="white"
  ];
  node [
    fontname="Microsoft YaHei",
    fontsize=10.5,
    shape=box,
    style="rounded,filled",
    fillcolor="#F7F9FC",
    color="#5B7DB1",
    penwidth=1.1,
    margin="0.16,0.09"
  ];
  edge [
    fontname="Microsoft YaHei",
    fontsize=9.5,
    color="#5B7DB1",
    arrowsize=0.75
  ];

  selected [label="selected 文件（已排序）", fillcolor="#E8F0FE"];
  mode [label="groupBy 选择", shape=diamond, fillcolor="#FFF4E5", color="#D98E2B", margin="0.08,0.05"];
  directory [label="directory（缺省）\n路径前两段\n不足两段用第一段\n根文件 → <root>"];
  files [label="files\n按排序切固定文件数桶"];
  language [label="language\n按扩展名分桶"];
  none [label="none\n每个文件一组"];
  sort [label="桶内按路径排序\n桶键按字典序排序"];
  nCheck [label="none 模式\n单文件估算 > maxGroupChars?", shape=diamond, fillcolor="#FFF4E5", color="#D98E2B", margin="0.08,0.05"];
  chunk [label="贪心切片\n同时受 maxFilesPerGroup\n与 maxGroupChars 约束"];
  single [label="单文件估算 > maxGroupChars?", shape=diamond, fillcolor="#FFF4E5", color="#D98E2B", margin="0.08,0.05"];
  solo [label="单独成组 soloLarge\n（单文件不可再拆\n仍受 maxFileChars 兜底）", fillcolor="#FFF8E8", color="#D98E2B"];
  groups [label="groups\n文件不跨组、不重复", fillcolor="#EAF7EE", color="#3C8D5A"];
  guard [label="groups > maxGroups?", shape=diamond, fillcolor="#FFF4E5", color="#D98E2B", margin="0.08,0.05"];
  fail [label="计划失败\nexit 2\n提示 --path 收窄 / 显式提高", fillcolor="#FDECEC", color="#C0504D"];
  synth [label="逐组合成\n中性快照 + 内部文件视图"];

  selected -> mode;
  mode -> directory;
  mode -> files;
  mode -> language;
  mode -> none;
  directory -> sort;
  files -> sort;
  language -> sort;
  none -> nCheck;
  nCheck -> solo [label=" 是"];
  nCheck -> groups [label=" 否\n每文件一组"];
  sort -> single;
  single -> solo [label=" 是"];
  single -> chunk [label=" 否"];
  chunk -> groups;
  solo -> groups;
  groups -> guard;
  guard -> fail [label=" 是", style=dashed, color="#C0504D", fontcolor="#C0504D"];
  guard -> synth [label=" 否"];

  note [shape=note, label="缺省 5 文件 / 80,000 估算字符 / 120,000 单文件\n5 文件来自全仓实跑：超过 5 个文件注意力下降\n80k ≈ 2,270 行；120k ≈ 3,400 行（35.2 B/行）", fillcolor="#FFF8E8", color="#D98E2B", fontsize=9];
  chunk -> note [style=dotted, arrowhead=none, color="#999999"];
}
