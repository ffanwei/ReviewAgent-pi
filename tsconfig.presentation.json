{
  // 呈现投影引擎编译程序（ADR-0010 消费端接线，ADR-0024 后只剩呈现层）：
  // 入口 src/presentation/engine-zh.ts + import 闭包（src/presentation +
  // review-pi 的 type-only 契约 + review-llm 共享客户端），产物
  // .tmp-gen/presentation/engine-zh.js ——经配置文件 `presentation.engine`
  // （~/.PiAgent/PiAgent.json 或 --config，ADR-0025）供 review-pi CLI 呈现缝
  // 动态加载；环境变量不再被读取。
  // 必须走 -p 而非内联 flags：内联 flags 忽略 tsconfig → baseUrl/paths
  // 失效。
  // files + include 覆盖（extends 的 include 不残留）：只编入口及其闭包。
  // rootDir 显式钉 src：包内闭包全部在 src/ 下，产物路径固定为
  // .tmp-gen/presentation/*.js（不随闭包组成漂移）；产物以裸名 import
  // "review-llm" / "review-pi"，node 经 node_modules 正常解析。
  // 前置：pnpm --filter review-pi build（type-only 契约经 paths 指向其
  // dist/index.d.ts）—— root script build:presentation 已串上。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": ".tmp-gen"
  },
  "files": ["src/presentation/engine-zh.ts"],
  "include": [],
  "exclude": ["node_modules", "dist", ".tmp-gen"]
}
