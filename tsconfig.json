{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    // #8 执行缝类型链：@baize/review-pi dist d.ts 的类型闭包（内核四包）经 node_modules
    // 直接消费上游 dist 的 .d.ts（skipLibCheck 跳过检查）。这里只需把 @baize/review-pi
    // 指到自己的 dist d.ts——根 src 里的裸名 import "@baize/review-pi" 才会解析到类型面
    // 而不是其 TS 源。运行时不受影响：node 经 node_modules 正常解析其
    // dist/index.js；vitest 侧按 "source" 条件解析 TS 源（另一条路）。
    "baseUrl": ".",
    "paths": {
      "@baize/review-pi": ["packages/review-pi/dist/index.d.ts"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
