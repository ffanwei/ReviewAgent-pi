{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  // 根包只承载 scripts/ 工具链的测试（核外回放指标解析等）；产品代码与测试
  // 都在 packages/review-pi 内，用包内 tsconfig / vitest 配置跑。
  "include": ["tests"],
  "exclude": ["node_modules", "dist"]
}
