flowchart TD
  A(["候选 finding"]) --> B{"文件在本次 diff？"}
  B -- "否" --> U["unverifiable"]
  B -- "是" --> C{"行号在文件范围？"}
  C -- "否" --> U
  C -- "是" --> D{"引文能匹配？"}
  D -- "是" --> G["grounded"]
  D -- "否" --> V["unverified"]
  G --> W["warn：只标记，不删除"]
  U --> W
  V --> W
  W --> X{"启用独立复核？"}
  X -- "否" --> Z(["输出：103 条存疑保留"])
  X -- "是" --> Y["新会话 pass / reject / uncertain<br/>fail-open"]
  Y --> Z

  classDef process fill:#F4F6F8,stroke:#B7C4CE,color:#14212B;
  classDef decision fill:#FBFCFD,stroke:#7D8D99,color:#14212B;
  classDef key fill:#DCEBE9,stroke:#0D6A68,color:#0D6A68;
  classDef bad fill:#F3E3DD,stroke:#A94F37,color:#A94F37;
  classDef terminal fill:#14212B,stroke:#14212B,color:#FBFCFD;
  class A,Z terminal;
  class B,C,D,X decision;
  class G,U,V,W,Y process;
  class V bad;
  class G key;
