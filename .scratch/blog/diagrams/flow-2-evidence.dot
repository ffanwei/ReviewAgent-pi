digraph G {
  graph [bgcolor="#FFFFFF", fontname="Microsoft YaHei", rankdir=TB, nodesep=0.32, ranksep=0.42, pad=0.28, label="② 证据接地 · 看了，但说错行号、编证据", labelloc=t, labeljust=l, fontsize=20, fontcolor="#14212B"];
  node [fontname="Microsoft YaHei", fontsize=13, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#B7C4CE", fontcolor="#14212B", penwidth=1.2, margin="0.16,0.09"];
  edge [fontname="Microsoft YaHei", fontsize=11, color="#7D8D99", arrowsize=0.7, penwidth=1.1];

  start [label="候选 finding", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];
  d1 [label="文件在本次 diff？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  d2 [label="行号在文件范围？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  d3 [label="引文能匹配？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  bad1 [label="unverifiable", fillcolor="#F3E3DD", color="#A94F37", fontcolor="#A94F37"];
  bad2 [label="unverified", fillcolor="#F3E3DD", color="#A94F37", fontcolor="#A94F37"];
  good [label="grounded", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  warn [label="warn：只标记，不删除", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  d4 [label="启用独立复核？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  verify [label="新会话 pass / reject / uncertain\nfail-open"];
  end [label="输出：存疑保留", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];

  start -> d1;
  d1 -> bad1 [label="否"];
  d1 -> d2 [label="是"];
  d2 -> bad1 [label="否"];
  d2 -> d3 [label="是"];
  d3 -> good [label="是"];
  d3 -> bad2 [label="否"];
  bad1 -> warn;
  bad2 -> warn;
  good -> warn;
  warn -> d4;
  d4 -> end [label="否"];
  d4 -> verify [label="是"];
  verify -> end;
}
