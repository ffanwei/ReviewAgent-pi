digraph G {
  graph [bgcolor="#FBFCFD", fontname="Microsoft YaHei", rankdir=LR, nodesep=0.32, ranksep=0.42, pad=0.28];
  node [fontname="Microsoft YaHei", fontsize=13, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#B7C4CE", fontcolor="#14212B", penwidth=1.2, margin="0.16,0.09"];
  edge [fontname="Microsoft YaHei", fontsize=11, color="#7D8D99", arrowsize=0.7, penwidth=1.1];

  start [label="MR diff", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];
  d1 [label="超过单片上限？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  d2 [label="还能切片？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  p1 [label="单遍检视", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  p2 [label="准入 / 分片\n≤ maxShards", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  bad [label="显式失败\n不静默跳过", fillcolor="#F3E3DD", color="#A94F37", fontcolor="#A94F37"];
  p3 [label="候选回填 hunk"];
  p4 [label="账本收口\n未回填 → not-reached", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  end [label="缺口可见\n22,266 hunk", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];

  start -> d1;
  d1 -> p1 [label="否"];
  d1 -> d2 [label="是"];
  d2 -> bad [label="否"];
  d2 -> p2 [label="是"];
  p2 -> p1 [label="切片后"];
  p1 -> p3;
  p3 -> p4;
  p4 -> end;
}
