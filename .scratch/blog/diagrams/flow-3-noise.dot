digraph G {
  graph [bgcolor="#FBFCFD", fontname="Microsoft YaHei", rankdir=TB, nodesep=0.32, ranksep=0.42, pad=0.28, label="③ 噪声治理 · 意见太吵，真问题反而没提", labelloc=t, labeljust=l, fontsize=20, fontcolor="#14212B"];
  node [fontname="Microsoft YaHei", fontsize=13, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#B7C4CE", fontcolor="#14212B", penwidth=1.2, margin="0.16,0.09"];
  edge [fontname="Microsoft YaHei", fontsize=11, color="#7D8D99", arrowsize=0.7, penwidth=1.1];

  start [label="一次检视", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];
  d1 [label="上下文策略", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  bad [label="全仓注入\n706.5k token / R 13.4%", fillcolor="#F3E3DD", color="#A94F37", fontcolor="#A94F37"];
  p1 [label="diff-first\n只带变更，按需取证", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  gate [label="候选门\n格式 / 行号 / 范围", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  conf [label="置信度 0.3\n范围标注"];
  d2 [label="有项目规则？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  skill [label="独立规则 Skill 会话"];
  main [label="主会话候选"];
  merge [label="合并 / 去重"];
  end [label="可解释的意见\n保留长尾，不硬删", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];

  start -> d1;
  d1 -> bad [label="全仓注入"];
  d1 -> p1 [label="diff-first"];
  p1 -> gate;
  gate -> conf;
  conf -> d2;
  d2 -> skill [label="是"];
  d2 -> main [label="否"];
  skill -> merge;
  main -> merge;
  merge -> end;
}
