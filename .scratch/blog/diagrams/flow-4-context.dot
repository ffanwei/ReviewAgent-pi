digraph G {
  graph [bgcolor="#FBFCFD", fontname="Microsoft YaHei", rankdir=TB, nodesep=0.32, ranksep=0.42, pad=0.28, label="④ 上下文有界 · 越读越大，最后超时", labelloc=t, labeljust=l, fontsize=20, fontcolor="#14212B"];
  node [fontname="Microsoft YaHei", fontsize=13, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#B7C4CE", fontcolor="#14212B", penwidth=1.2, margin="0.16,0.09"];
  edge [fontname="Microsoft YaHei", fontsize=11, color="#7D8D99", arrowsize=0.7, penwidth=1.1];

  start [label="一次 pass", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];
  d1 [label="单片超过 120k 字符？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  split [label="按 hunk 分片\n≤ 12 片", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  single [label="单遍"];
  conc [label="有界并发 1–8\n片序聚合", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  tools [label="工具结果 8k 上限\n搜索每文件 20 条"];
  d2 [label="同一文件 >3 次\n或连续空搜 >4？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  skip [label="跳过并提示\n用已有内容"];
  cont [label="继续"];
  d3 [label="窗口将溢出？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  retry [label="收窄输出\n400 减半重试"];
  end [label="有界请求\n不杀整次 run", fillcolor="#14212B", color="#14212B", fontcolor="#FBFCFD"];

  start -> d1;
  d1 -> split [label="是"];
  d1 -> single [label="否"];
  split -> conc;
  single -> conc;
  conc -> tools;
  tools -> d2;
  d2 -> skip [label="是"];
  d2 -> cont [label="否"];
  skip -> d3;
  cont -> d3;
  d3 -> retry [label="是"];
  d3 -> end [label="否"];
  retry -> end;
}
