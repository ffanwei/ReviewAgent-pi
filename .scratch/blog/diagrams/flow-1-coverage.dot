digraph G {
  graph [bgcolor="#FFFFFF", fontname="Microsoft YaHei", rankdir=TB, nodesep=0.30, ranksep=0.34, pad=0.25, label="① 覆盖账本 · 没看，却说审完了", labelloc=t, labeljust=l, fontsize=20, fontcolor="#14212B"];
  node [fontname="Microsoft YaHei", fontsize=12, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#B7C4CE", fontcolor="#14212B", penwidth=1.1, margin="0.14,0.07"];
  edge [fontname="Microsoft YaHei", fontsize=10, color="#7D8D99", arrowsize=0.65, penwidth=1.1];

  start [label="MR diff", fillcolor="#14212B", color="#14212B", fontcolor="#FFFFFF"];
  d1 [label="超过单片上限？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  d2 [label="还能切片？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  bad [label="显式失败\n不静默跳过", fillcolor="#F3E3DD", color="#A94F37", fontcolor="#A94F37"];
  p2 [label="准入 / 分片\n≤ maxShards", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  p1 [label="单遍检视", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  stages [label="六阶段检视\n① 变更理解 → ② 风险分级 → ③ 上下文决策\n④ 上下文检索 → ⑤ 深度推理 → ⑥ 证据校验", fontsize=11, fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  p3 [label="候选回填 hunk"];
  p4 [label="账本收口\n未回填 → not-reached(cause)", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  causes [label="cause：no-signal · truncated · budget\noutput-truncated · flow-error · round-cap", shape=note, style="filled", fillcolor="#F4F6F8", color="#B7C4CE", fontcolor="#586977", fontsize=10];
  d3 [label="还有 not-reached？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  d4 [label="补看开启？", shape=diamond, style="filled", fillcolor="#FBFCFD", color="#7D8D99", margin="0.02,0.02"];
  keep [label="保持 not-reached\n缺口照实暴露"];
  repair [label="只补 no-signal\n超预算 → not-reached(budget)", fillcolor="#DCEBE9", color="#0D6A68", fontcolor="#0D6A68"];
  gate [label="回执 no-issue / candidate\n候选仍过候选门"];
  end [label="缺口可见\ncoverage.json + cause 分布\n不把缺口写成「已审」", fillcolor="#14212B", color="#14212B", fontcolor="#FFFFFF"];

  start -> d1;
  d1 -> p1 [label="否"];
  d1 -> d2 [label="是"];
  d2 -> bad [label="否"];
  d2 -> p2 [label="是"];
  p2 -> stages [label="切片后"];
  p1 -> stages;
  stages -> p3;
  p3 -> p4;
  p4 -> causes [style=dotted, arrowhead=none];
  p4 -> d3 [label="收口后"];
  d3 -> end [label="无"];
  d3 -> d4 [label="有"];
  d4 -> keep [label="否"];
  d4 -> repair [label="是"];
  repair -> gate;
  gate -> end;
  keep -> end;
}
