%%{init: {"theme":"base","themeVariables":{"primaryColor":"#DCEBE9","primaryTextColor":"#14212B","primaryBorderColor":"#0D6A68","lineColor":"#7D8D99","secondaryColor":"#F4F6F8","tertiaryColor":"#FBFCFD","fontFamily":"Noto Sans SC, Microsoft YaHei, sans-serif","fontSize":"14px"}}}%%
flowchart TD
  A(["一次 pass"]) --> B{"单片超过 120k 字符？"}
  B -- "是" --> C["按 hunk 分片<br/>≤ 12 片"]
  B -- "否" --> D["单遍"]
  C --> E["有界并发 1–8<br/>片序聚合"]
  D --> E
  E --> F["工具结果 8k 上限<br/>搜索每文件 20 条"]
  F --> G{"同一文件 >3 次<br/>或连续空搜 >4？"}
  G -- "是" --> H["跳过并提示<br/>用已有内容"]
  G -- "否" --> I["继续"]
  H --> J{"窗口将溢出？"}
  I --> J
  J -- "是" --> K["收窄输出<br/>400 减半重试"]
  J -- "否" --> L(["有界请求<br/>不杀整次 run"])
  K --> L

  classDef process fill:#F4F6F8,stroke:#B7C4CE,color:#14212B;
  classDef decision fill:#FBFCFD,stroke:#7D8D99,color:#14212B;
  classDef key fill:#DCEBE9,stroke:#0D6A68,color:#0D6A68;
  classDef bad fill:#F3E3DD,stroke:#A94F37,color:#A94F37;
  classDef terminal fill:#14212B,stroke:#14212B,color:#FBFCFD;
  class A,L terminal;
  class B,G,J decision;
  class C,D,E,F,H,I,K process;
  class E,F key;
