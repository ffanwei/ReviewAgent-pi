# 参考项目：外部克隆的仓库（deepseek-harness / pi），不属于本项目源码
reference_project/

# API key 本机注入（推荐名 REVIEWER_API_KEY / JUDGE_API_KEY，旧名
# DEEPSEEK_API_KEY / OPENAI_API_KEY 兼容；绝不入库）
.env.local
.env

# Claude Code 本机配置（每台机器不同，不入库）
.claude/settings.local.json

# .claude/skills 是指向 .agents/skills 的 NTFS junction（本机链接，不入库；
# 真实的 skills 存储在 .agents/skills/，随仓库提交）
.claude/skills

# Claude Code 本机运行产物（/implement-spec 子代理 worktree / 崩溃转储）
.claude/worktrees/
*.stackdump

# Node 工程产物
node_modules/
dist/
coverage/
*.tsbuildinfo
# 呈现引擎制品（ADR-0026：build:presentation 从 .tmp-gen/presentation/ 复制过来；
# `presentation.engine = "builtin"` 指向这里——构建产物，不入库）
packages/review-pi/presentation/
# pi 内核包工具产物（packages/ai generate-model-catalog 输出目标 ../../.artifacts/）
.artifacts/

# 检视运行审计痕迹（runReview 默认落盘目录；数据/记录不入库，
# 但目录本身保持可扫描——评测报告 REPORT.md 作为结论文档例外入库）
runs/**
!runs/**/
!runs/**/REPORT.md

# review-pi CLI 缺省输出目录（#7 --out 缺省 review-pi-output；审计与运行记录不入库）
review-pi-output/

# 分组式检视意见的执行目录副本（ADR-0017 决策 14：写到进程 cwd；从仓库根跑检视
# 就会落在这里。真源在 runs/ 下的 rep-<N>/，故这两份不入库）
/reviews_tips_zh.json
/review-result.json

# clean MR 采集 API 快照缓存（断点续采用；清单与 diff 为交付物，正常入库）
data/clean-mr/.cache/

# 脚本编译临时目录（T02/T09 采集脚本的 tsc outDir）
.tmp-gen/
.tmp-gen-host/

# 数据集清单生成脚本下载缓存（scripts/generate-*-manifest.ts）
.cache/

# understand
.ua/
.vscode/settings.json
.opencode/commands/qa-save.md
.agents/skills/qa-journal/SKILL.md
# 规则 Skill 示例包：素材入库（SKILL.md / rules/ / scripts/），打包产物不入库
# （重打：cd packages/review-pi/testdata/rule-skills && tar -a -c -f general-code-review.zip general-code-review）
packages/review-pi/testdata/rule-skills/**/*.zip
