{
  "name": "review-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "pi 内核线 Review CLI：一条命令完成一次 MR 检视，产出英文 findings 与中文按行分组建议（ADR-0024 / ADR-0028）",
  "bin": {
    "review-pi": "./bin/review-pi.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "presentation",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepare-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@review-agent-pi/pi-agent-core": "workspace:*",
    "@review-agent-pi/pi-ai": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "jsonc-parser": "3.3.1",
    "review-llm": "workspace:*",
    "tree-sitter-java": "0.23.5",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
