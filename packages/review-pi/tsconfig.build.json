{
  // dist 构建程序：内核四包按 npm 依赖消费上游 dist 的 .d.ts（skipLibCheck 跳过
  // 检查，仅用公开 API 面），不再需要指向仓内 vendored 产物的 paths。
  // 相对继承的 tsconfig.json 只做两件事：允许 emit、把宽松 flags 收回到全量严格
  // （本包自有代码按最严标准构建），并把测试/夹具目录排除在产物之外。
  // src/e2e（真跑冒烟 e2e 基础设施）不进 dist。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testing", "src/e2e", "node_modules", "dist"]
}
