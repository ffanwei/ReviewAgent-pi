{
  // 继承根 tsconfig；两处加严 flags 只对**测试/夹具**放宽（ADR-0035 执行记录）：
  // 内核四包改成 npm 依赖后，product 代码不再有 vendored 源码进程序，由
  // tsconfig.build.json 以全量严格 flags 编译（build 是 CI 门）；而本 tsconfig
  // 的 include 覆盖 src/**（含 *.test.ts 与 src/testing 夹具），这些文件里有 32
  // 处数组索引/可选属性的既有写法过不了 noUncheckedIndexedAccess /
  // exactOptionalPropertyTypes——它们不属于本次切换的关注点，逐条加断言是纯
  // 噪声，故在此保留两处放宽并记账，作为独立清理项。
  // allowImportingTsExtensions 的让步已收回：没有 vendored 源码 import 了。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
