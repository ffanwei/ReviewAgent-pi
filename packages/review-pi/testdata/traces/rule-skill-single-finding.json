            "strict": false
          }
        },
        {
          "type": "function",
          "function": {
            "name": "review_get_symbol",
            "description": "按简单名在已配置的源码语言中查找符号，返回签名级声明（种类、修饰符、返回类型、参数、行号；不含方法体）。类型命中含其成员。符号索引支持 Java、TypeScript/JavaScript、Python、Go、C/C++；其他语言（如 C#、Rust、PHP）请改用 review.search_code 做文本定位。",
            "parameters": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string",
                  "description": "要查找的简单（非限定）符号名，例如 \"sumFirst\" 或 \"MathUtils\"。"
                }
              },
              "required": [
                "symbol"
              ],
              "additionalProperties": false
            },
            "strict": false
          }
        },
        {
          "type": "function",
          "function": {
            "name": "review_get_file",
            "description": "读取仓库快照中的文件。可选用 1 起算的闭区间行范围（startLine/endLine）。",
            "parameters": {
              "type": "object",
              "properties": {
                "endLine": {
                  "type": "integer",
                  "description": "读取的最后一行（1 起算、含端点）。可选，缺省到文件末尾。"
                },
                "path": {
                  "type": "string",
                  "description": "要读取文件的仓库相对 POSIX 路径。"
                },
                "startLine": {
                  "type": "integer",
                  "description": "读取的首行（1 起算、含端点）。可选，缺省为 1。"
                }
              },
              "required": [
