    {
      "digest": "sha256:97d63a11d72bcf02407ce0baa5ae2d1756fbe3f7387484833e58195d0838410d",
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "review_get_diff",
            "description": "返回本次受检合并请求（MR）的 unified diff。",
            "parameters": {
              "type": "object",
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "最多返回的 diff 行数（页大小）。"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "要返回的首行 diff 行号（1 起算）。"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "strict": false
          }
        },
        {
          "type": "function",
          "function": {
            "name": "review_get_symbol",
            "description": "按简单名在已配置的源码语言中查找符号，返回签名级声明（种类、修饰符、返回类型、参数、行号；不含方法体）。类型命中含其成员。符号索引支持 Java、TypeScript/JavaScript、Python、Go、C/C++；其他语言（如 C#、Rust、PHP）请改用 review.search_code 做文本定位。",
            "parameters": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string",
                  "description": "要查找的简单（非限定）符号名，例如 \"sumFirst\" 或 \"MathUtils\"。"
                }
              },
              "required": [
                "symbol"
              ],
              "additionalProperties": false
            },
            "strict": false
          }
        },
        {
          "type": "function",
          "function": {
            "name": "review_get_file",
            "description": "读取仓库快照中的文件。可选用 1 起算的闭区间行范围（startLine/endLine）。",
            "parameters": {
              "type": "object",
              "properties": {
                "endLine": {
                  "type": "integer",
                  "description": "读取的最后一行（1 起算、含端点）。可选，缺省到文件末尾。"
                },
                "path": {
                  "type": "string",
                  "description": "要读取文件的仓库相对 POSIX 路径。"
                },
                "startLine": {
                  "type": "integer",
                  "description": "读取的首行（1 起算、含端点）。可选，缺省为 1。"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            },
            "strict": false
          }
        },
        {
          "type": "function",
          "function": {
            "name": "review_find_references",
            "description": "在已配置的源码语言中查找某符号的名称级引用（整词、区分大小写；不做类型解析，重载与覆写不区分）。返回声明与使用位置及其所属符号。支持 Java、TypeScript/JavaScript、Python、Go、C/C++；其他语言（如 C#、Rust、PHP）请改用 review.search_code。",
            "parameters": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string",
                  "description": "要搜索的简单（非限定）符号名，例如 \"sumFirst\" 或 \"MathUtils\"。"
                }
              },
              "required": [
                "symbol"
              ],
              "additionalProperties": false
            },
            "strict": false
          }
        },
        {
          "type": "function",
          "function": {
            "name": "review_get_call_chain",
            "description": "围绕某方法 / 函数 / 构造器构建名称级调用链：一跳调用方、二跳调用方，以及声明体内调用的被调方。整词名称匹配、不做类型解析；不区分重载。支持 Java、TypeScript/JavaScript、Python、Go、C/C++；其他语言（如 C#、Rust、PHP）请改用 review.search_code。同名声明很多时请用 file 收窄。",
            "parameters": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "可选：限定声明的仓库相对 POSIX 路径，例如 \"src/foo.c\"；同名方法很多时用它收窄。"
                },
                "symbol": {
                  "type": "string",
                  "description": "构建调用链所用方法 / 函数 / 构造器的简单名，例如 \"sumFirst\"。"
                }
              },
              "required": [
                "symbol"
              ],
              "additionalProperties": false
            },
            "strict": false
          }
        },
        {
          "type": "function",
          "function": {
            "name": "review_search_code",
            "description": "在仓库快照中按文本或正则搜索，返回命中的「文件:行号:整行内容」。默认字面匹配、不区分大小写；literal 模式不解释正则元字符，需要 `|`、分组、字符类等写法时请传 regex:true。用于定位字符串、配置键、错误文案、日志消息等文本线索；已知符号名请优先用 review.get_symbol / review.find_references，符号工具不支持的语言（如 C#、Rust、PHP）则用本工具定位。结果有上限且不分页，命中过多时请收窄 query 或加 glob。正则使用 Rust regex 语法，不支持 lookaround 与反向引用。",
            "parameters": {
              "type": "object",
              "properties": {
                "caseSensitive": {
                  "type": "boolean",
                  "description": "是否区分大小写。缺省 false（不区分）。"
                },
                "glob": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "限定搜索范围的文件 glob，支持 \"!\" 负向，例如 [\"src/**\", \"!**/*.test.ts\"]。缺省搜索整个仓库快照。"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200,
                  "description": "最多返回的命中行数。缺省 50，上限 200。"
                },
                "query": {
                  "type": "string",
                  "description": "要搜索的文本或正则。"
                },
                "regex": {
                  "type": "boolean",
                  "description": "为 true 时把 query 当作正则（Rust regex 语法）。缺省 false（字面）。"
                }
              },
              "required": [
                "query"
              ],
              "additionalProperties": false
            },
            "strict": false
          }
        }
      ]
    }
