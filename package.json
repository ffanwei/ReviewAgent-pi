{
  "name": "@baize/review-agent-pi",
  "version": "0.6.1",
  "type": "module",
  "description": "pi 内核线的 Review CLI 产品仓：一次检视产出英文 findings + 中文按行分组建议（ADR-0024）",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:presentation": "pnpm --filter @baize/review-pi build && pnpm exec tsc -p tsconfig.presentation.json && node scripts/copy-presentation.mjs",
    "build:dist": "pnpm build:presentation",
    "pack:packages": "node scripts/pack-packages.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "publish:packages": "pnpm build:dist && pnpm -r publish",
    "replay:record": "node scripts/offline-replay/run.mjs record --scenario",
    "replay:once": "node scripts/offline-replay/run.mjs once --scenario",
    "replay:ramp": "node scripts/offline-replay/run.mjs ramp --scenario",
    "test:replay": "node scripts/offline-replay/test-all.mjs",
    "eval:vul4j": "node scripts/eval/vul4j-eval.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@baize/review-pi": "workspace:*"
  }
}
