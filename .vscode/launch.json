{
  "version": "0.2.0",
  "configurations": [
    {
      // 真实链路（唯一形态）：零成本前先确认 .env.local 有 REVIEWER_URL / REVIEWER_API_KEY
      "name": "review-pi (real gateway)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Users\\Li\\AppData\\Local\\nvm\\v22.23.3\\node.exe",
      "program": "${workspaceFolder}/packages/review-pi/dist/cli/main.js",
      "args": [
        "review",
        "--repo", "${workspaceFolder}/.cache/datasets/vul4j-repos/VUL4J-38-ab6cbdc3da",
        "--mr", "${workspaceFolder}/.cache/datasets/vul4j-diffs/VUL4J-38.diff",
        "--out", "${workspaceFolder}/runs/debug-single"
      ],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      // 离线：唯一形态的检视链回归，SSE fake，零网络零 token（在 review-pi 包内跑）
      "name": "offline (review-pi vitest)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/review-pi",
      "runtimeExecutable": "C:\\Users\\Li\\AppData\\Local\\nvm\\v22.23.3\\node.exe",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--no-file-parallelism"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal"
    },
    {
      // 离线：呈现层回归（root 测试面）
      "name": "offline (presentation vitest)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Users\\Li\\AppData\\Local\\nvm\\v22.23.3\\node.exe",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--no-file-parallelism"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal"
    }
  ]
}
